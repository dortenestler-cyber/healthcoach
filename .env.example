# Vorlage für die Umgebungsvariablen der Web-App.
# Kopiere diese Datei nach .env.local und trage die Werte aus deinem Supabase-Projekt ein.
# .env.local wird nie ins Repo hochgeladen.

# Öffentlich (darf im Browser landen, ist durch den Zugriffsschutz pro Konto abgesichert)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Geheime Schlüssel gehören NICHT hierher, sondern in die Secrets von Supabase:
#   ANTHROPIC_API_KEY        (Claude-API für den Coach)
#   GARMIN_* Zugangsdaten    (Garmin Personal API)
#   SUPABASE_SERVICE_ROLE_KEY
# Diese nutzen nur die Edge Functions im Backend, nie die App im Browser.
